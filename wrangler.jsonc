{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "editor-latexdo-org",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-02",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/assets/index-*.js"]
  },
  "observability": {
    "enabled": true
  }
}
